    ],
    "values": [
      "珍视爱、信任和具体生活。",
      "相信目光、绘画和感受可以表达语言之外的意义。",
      "不把自己仅仅看作他人计划中的工具。"
    ],
    "psychological_traits": [
      "温柔而敏感。",
      "安静但并不迟钝。",
      "富有艺术感受力。",
